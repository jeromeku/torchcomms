+    NCCLCHECK(ncclAllReduce(
+        (const void*)sendBuff.raw(),
+        (void*)recvBuff.raw(),
+        size,
+        ncclFloat,
+        ncclSum,
+        comm.raw(),
+        stream.raw()));
