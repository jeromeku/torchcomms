-
-  devr->bigSize = ncclParamWinStride();
-  if (-devr->bigSize <= 1) {
-    devr->bigSize = 1;
-    for (int r=0; r < comm->nRanks; ++r) {
-      devr->bigSize = std::max<size_t>(devr->bigSize, comm->peerInfo[r].totalGlobalMem);
-    }
-  }
-  devr->bigSize = alignUp(devr->bigSize, size_t(1)<<32);
