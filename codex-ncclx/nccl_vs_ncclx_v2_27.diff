+        "NCCL_COLLTRACE=trace",
+        "NCCL_COLLTRACE_USE_NEW_COLLTRACE=1",
+        // enable ctran
+        "NCCL_CTRAN_ENABLE=1",
+        "NCCL_CTRAN_BACKENDS=ib",
+        "NCCL_ALLREDUCE_ALGO=ctran",
+        fmt::format(
+            "NCCL_DEBUG_FILE={}", (tmpDir_.path() / "logfile%p").string()),
