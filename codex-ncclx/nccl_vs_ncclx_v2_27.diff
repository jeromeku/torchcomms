-#if DOCA_GPUNETIO_VERBS_ENABLE_DEBUG == 1
-    if (opcode == DOCA_GPUNETIO_IB_MLX5_CQE_REQ_ERR) doca_gpu_dev_verbs_cq_print_cqe_err(cqe64);
