+      NCCLCHECK(ncclSocketRecv(nextSocket, data + (rsliceNext * size), size));
+    }
+    return ncclSuccess;
+  };
+  auto forwardLoopFuture = std::async(std::launch::async, forwardLoop);
+  auto backwardLoopFuture = std::async(std::launch::async, backwardLoop);
+  NCCLCHECK(forwardLoopFuture.get());
+  NCCLCHECK(backwardLoopFuture.get());
+
+  return ncclSuccess;
+}
