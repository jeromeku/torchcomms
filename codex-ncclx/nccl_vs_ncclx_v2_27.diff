-    if (nic_handler == DOCA_GPUNETIO_VERBS_NIC_HANDLER_AUTO) {
-        const enum doca_gpu_dev_verbs_nic_handler qp_nic_handler =
-            (enum doca_gpu_dev_verbs_nic_handler)__ldg((int *)&qps[0]->nic_handler);
