-      ncclSpaceAlloc(&ginState->counterSpace, ginState->counterSpaceSize, nCounters, 1, &start),
-      ret, fail_signals);
-    *outCounter0 = (uint32_t)start;
-  }
-  return ncclSuccess;
-fail_signals:
-  if (nSignals != 0) ncclSpaceFree(&ginState->signalSpace, *outSignal0, nSignals);
-fail:
-  return ret;
