+        sendbuff,
+        sendcounts,
+        sdispls,
+        recvbuff,
+        recvcounts,
+        rdispls,
+        ncclToMetaComm(datatype),
+        comm->ctranComm_.get(),
+        stream));
+  }
+
+  // fallback to baseline send/recv based alltoallv
+  NCCLCHECK(ncclGroupStart());
+  for (int r = 0; r < comm->nRanks; r++) {
+    NCCLCHECK(baseSend(
+        ((char*)sendbuff) + sdispls[r] * ncclTypeSize(datatype),
+        sendcounts[r],
