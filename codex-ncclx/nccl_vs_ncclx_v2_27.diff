-  do {                                                                         \
-    int err = cmd;                                                             \
-    if (err != MPI_SUCCESS) {                                                  \
-      char error_string[MPI_MAX_ERROR_STRING];                                 \
-      int length;                                                              \
-      MPI_Error_string(err, error_string, &length);                            \
