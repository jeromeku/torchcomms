-                                            CUdeviceptr ptr);
-typedef CUresult (*cuMemGetHandleForAddressRange_t)(int *pHandle, CUdeviceptr dptr, size_t size,
-                                                    CUmemRangeHandleType handleType,
-                                                    unsigned long long flags);
