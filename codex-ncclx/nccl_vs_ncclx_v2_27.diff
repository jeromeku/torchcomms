+
+TEST_F(AlgoConfigUT, AlgoDefaultCtran) {
+  setenv("NCCL_SENDRECV_ALGO", "ctran", 1);
+  ncclx::testOnlyResetGlobalHints();
+  testOnlyResetAlgoConfig();
