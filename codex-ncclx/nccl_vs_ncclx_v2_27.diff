-NCCL_HOST_DEVICE_INLINE uint32_t imulRcp32(uint32_t x, uint32_t xrcp, uint32_t y, uint32_t yrcp) {
-  if (xrcp == 0) return yrcp;
-  if (yrcp == 0) return xrcp;
-  uint32_t rcp = mul32hi(xrcp, yrcp);
-  uint32_t rem = -x*y*rcp;
-  if (x*y <= rem) rcp += 1;
-  return rcp;
