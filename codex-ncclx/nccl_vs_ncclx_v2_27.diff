+    EXPECT_EQ(childComm, (ncclComm_t)(NCCL_COMM_NULL));
+  } else {
+    NCCLCHECK_TEST(
+        ncclCommSplit(rootComm, 1, this->globalRank, &childComm, &childConfig));
+    EXPECT_NE(childComm, (ncclComm_t)(NCCL_COMM_NULL));
