diff -ruN thirdparty/nccl/meta/tests/tests_common.cuh comms/ncclx/v2_27/meta/tests/tests_common.cuh
--- thirdparty/nccl/meta/tests/tests_common.cuh	1970-01-01 00:00:00.000000000 +0000
