+  regHandle = win->handle;
+  if (regHandle && NCCL_LOCAL_REGISTER && ncclCuMemEnable()) {
+    if (regHandle->baseSymPtr) {
+      CUDACHECKGOTO(cudaSetDevice(comm->cudaDev), ret, fail);
