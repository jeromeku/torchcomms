+    }
+    NCCLCHECKGOTO(commDeregister(comm, false, regHandle), ret, fail);
+  }
+  free(win);
+exit:
+  CUDACHECK(cudaSetDevice(saveDev));
+  return ret;
+fail:
+  goto exit;
+}
