-        ".reg .b32 mask;\n\t"
-        ".reg .b32 ign;\n\t"
-        "mov.b32 mask, 0x0123;\n\t"
-        "prmt.b32 %0, %1, ign, mask;\n\t"
-        "}"
-        : "=r"(ret)
-        : "r"(x));
