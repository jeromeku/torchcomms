+
+  EXPECT_EQ(
+      ncclx::setGlobalHint(
+          std::string{testGlobalHintKey}, std::string{testGlobalHintVal}),
+      ncclSuccess);
+
+  auto result = ncclx::getGlobalHint(std::string{testGlobalHintKey});
