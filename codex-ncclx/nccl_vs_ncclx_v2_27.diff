-
-  CUmemAllocationProp memProp = {};
-  memProp.type = CU_MEM_ALLOCATION_TYPE_PINNED;
-  memProp.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
-  memProp.requestedHandleTypes = ncclCuMemHandleType;
