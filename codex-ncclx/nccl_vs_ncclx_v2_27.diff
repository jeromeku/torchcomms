+ncclResult_t ncclIbLogCollective(void* comm, uint8_t collOp, uint64_t commHash, bool isSend) {
+  // Determine comm type and access pattern
+  struct ncclIbNetCommBase* base;
+  const char* logPrefix;
+
+  if (isSend) {
+    base = &((struct ncclIbSendComm*)comm)->base;
+    logPrefix = "[COLLECTIVE_QP_SEND]";
+
+  } else {
+    base = &((struct ncclIbRecvComm*)comm)->base;
+    logPrefix = "[COLLECTIVE_QP_RECV]";
+  }
+
+  // Common logging logic
+  if (collOp < ncclNumFuncs && !base->loggedCollectives[collOp]) {
+    for (int q = 0; q < base->nqps; q++) {
+      int devIndex = base->qps[q].devIndex;
+      int ibDevIndex;
+
+      if (isSend) {
+        ibDevIndex = ((struct ncclIbSendComm*)comm)->devs[devIndex].base.ibDevN;
+      } else {
+        ibDevIndex = ((struct ncclIbRecvComm*)comm)->devs[devIndex].base.ibDevN;
+      }
+
+      INFO(NCCL_REG, "%s,CommHash,%lx,Ifname,%s,Ifdev,%d,Collective,%s,QP,%d",
+           logPrefix, commHash, ncclIbDevs[ibDevIndex].devName, ncclIbDevs[ibDevIndex].device,
+           ncclFuncToString((ncclFunc_t)collOp), base->qps[q].qp->qp_num);
+    }
+    base->loggedCollectives[collOp] = true;
+  }
+
+  return ncclSuccess;
+}
