-__device__ static __forceinline__ uint64_t doca_gpu_dev_verbs_bswap64(uint64_t x) {
-    uint64_t ret;
-    asm volatile(
-        "{\n\t"
-        ".reg .b32 mask;\n\t"
-        ".reg .b32 ign;\n\t"
-        ".reg .b32 lo;\n\t"
-        ".reg .b32 hi;\n\t"
-        ".reg .b32 new_lo;\n\t"
-        ".reg .b32 new_hi;\n\t"
-        "mov.b32 mask, 0x0123;\n\t"
-        "mov.b64 {lo,hi}, %1;\n\t"
-        "prmt.b32 new_hi, lo, ign, mask;\n\t"
-        "prmt.b32 new_lo, hi, ign, mask;\n\t"
-        "mov.b64 %0, {new_lo,new_hi};\n\t"
-        "}"
-        : "=l"(ret)
-        : "l"(x));
-    return ret;
-}
