+        std::make_tuple(
+            NCCL_REDUCESCATTER_ALGO::ctran,
+            false,
+            true,
+            kMemNcclMemAlloc,
+            268435456,
+            true),
+        std::make_tuple(
+            NCCL_REDUCESCATTER_ALGO::ctrhd,
+            false,
+            true,
+            kMemNcclMemAlloc,
+            8192,
+            true),
+        std::make_tuple(
+            NCCL_REDUCESCATTER_ALGO::ctrhd,
+            false,
