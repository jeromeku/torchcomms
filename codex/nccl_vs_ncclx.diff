-static bool doca_gpu_enable_gdrcopy() {
-    const char *env = getenv("DOCA_GPUNETIO_DISABLE_GDRCOPY");
-    if (env && atoi(env) != 0) {
-        DOCA_LOG(LOG_INFO, "DOCA_GPUNETIO_DISABLE_GDRCOPY is set, disabling GDRCopy");
-        return false;
-    }
-    return true;
