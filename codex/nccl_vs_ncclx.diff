+void printCommStateX(const ncclComm& comm) {
+  const auto statex = comm.ctranComm_->statex_.get();
+  VLOG(1) << "=== CommStateX ===";
+  VLOG(1) << "CommStateX " << &comm << ": ";
+  VLOG(1) << "rank: " << statex->rank();
