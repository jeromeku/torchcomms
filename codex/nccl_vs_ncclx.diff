-                                                                uint32_t uar_type);
-typedef void (*mlx5dv_devx_free_uar_func_t)(struct mlx5dv_devx_uar *uar);
-typedef int (*mlx5dv_query_device_func_t)(struct ibv_context *context,
-                                          struct mlx5dv_context *attrs_out);
