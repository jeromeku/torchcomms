-#define NCCL_TOPO_XML_DEPTH_MAX 256
-typedef struct xmlNodeStack {
-  ncclXmlNode* elems[NCCL_TOPO_XML_DEPTH_MAX];
-  int tail;
-
-  ncclXmlNode* top() {
-    if (!empty()) {
-      return elems[tail - 1];
-    } else {
-      return NULL;
-    }
-  }
-
-  ncclXmlNode* pop() {
-    ncclXmlNode* node = top();
-    if (node) {
-      tail--;
-    }
-    return node;
-  }
-
-  void push(ncclXmlNode* node) {
-    if (tail < NCCL_TOPO_XML_DEPTH_MAX) {
-      elems[tail++] = node;
-    }
-  }
-
-  bool empty() {
-    return tail == 0;
-  }
-
-} xmlNodeStack;
