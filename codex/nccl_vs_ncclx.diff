-  case JSON_OBJECT_EMPTY:
-    jsonReplaceState(jfo, JSON_OBJECT_SOME);
-    break;
-  case JSON_OBJECT_SOME:
-    fprintf(jfo->fp, ",");
-    break;
-  default:
-    return jsonUnknownStateError;
