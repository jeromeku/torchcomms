-    index = node->nAttrs++;
-    strncpy(node->attrs[index].key, attrName, MAX_STR_LEN);
-    node->attrs[index].key[MAX_STR_LEN] = '\0';
-  }
-  strncpy(node->attrs[index].value, value, MAX_STR_LEN);
-  node->attrs[index].value[MAX_STR_LEN] = '\0';
-  return ncclSuccess;
-}
