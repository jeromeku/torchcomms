+#define CAPTURE_STDOUT_WITH_FAIL_SAFE()                                    \
+  testing::internal::CaptureStdout();                                      \
+  SCOPE_FAIL {                                                             \
+    std::string output = testing::internal::GetCapturedStdout();           \
+    std::cout << "Test failed with stdout being: " << output << std::endl; \
+  };
