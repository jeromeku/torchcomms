-int main(int argc, char** argv) {
-  parseArgs(argc, argv);
-
-  if (connectToNCCL())
-    return 1;
-
-  if (getNCCLStatus()) {
-    (void)close(sock);
-    return 1;
-  }
-
-  if (close(sock) == -1) {
-    perror("close socket");
-    return 1;
-  }
-  return 0;
-}
