+  // posting multiple small allreduce in single group, e.g., coalesced
+  constexpr int numAR = 10;
+  ncclGroupStart();
+  for (int i = 0; i < numAR; ++i) {
+    EXPECT_EQ(
+        ncclAllReduce(sendBuf, recvBuf, count, dataType, ncclSum, comm, stream),
+        ncclSuccess);
