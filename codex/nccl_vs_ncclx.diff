-    if (SEND) {
-      // Yes, for some template arguments this code will be unreachable.  That's fine.
-      // coverity[dead_error_line]
-      for (int i=1; i < MaxSend && i < fan.nsend(); i++)
-        incSend(i, offset);
-      incSend(0, offset);
-    }
-  }
