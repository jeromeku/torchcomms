-  __device__ ncclSymkArgsHandler(ncclSymkDevWorkArgs const* args):
-    comm(args->kcomm.devComm),
-    lsaLLA2A(args->kcomm.lsaLLA2A) {
-    channelWorkRange = args->getWorkRange();
