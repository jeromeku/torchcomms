-    if (!is_tried_init) {
-        bool enabled = doca_gpu_enable_gdrcopy();
-        is_supported = (enabled && (doca_gpu_init_gdrcopy() == 0));
-        DOCA_LOG(LOG_INFO, "GDRCopy usage is %s", is_supported ? "enabled" : "disabled");
-        is_tried_init = true;
-    }
