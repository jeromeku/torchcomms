diff -ruN thirdparty/nccl/stable/meta/tests/AllReduceNumericOffsetTest.cc comms/ncclx/stable/meta/tests/AllReduceNumericOffsetTest.cc
--- thirdparty/nccl/stable/meta/tests/AllReduceNumericOffsetTest.cc	1970-01-01 00:00:00.000000000 +0000
+++ comms/ncclx/stable/meta/tests/AllReduceNumericOffsetTest.cc	2025-10-21 14:02:41.280165508 +0000
@@ -0,0 +1,229 @@
+// (c) Meta Platforms, Inc. and affiliates. Confidential and proprietary.
+
+#include <stdlib.h>
+#include <cstddef>
+
+#include <gmock/gmock.h>
+#include <gtest/gtest.h>
+
+#include <folly/init/Init.h>
+
+#include <comm.h>
+#include <nccl.h>
