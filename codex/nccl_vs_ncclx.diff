+static inline int ncclFuncTrafficPerByte(ncclFunc_t func, int nRanks) {
+  switch (func) {
+  case ncclFuncAllReduce: return 2;
+  case ncclFuncAllGather: return nRanks;
+  case ncclFuncReduceScatter: return nRanks;
+  default: return 1;
+  }
+}
