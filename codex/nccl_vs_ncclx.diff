-      // Bind new team with all existing memories.
-      for (struct ncclDevrMemory* mem = devr->memHead; mem != nullptr; mem = mem->next) {
-        NCCLCHECKGOTO(symBindTeamMemory(comm, t, mem), ret, fail_mcHandle_mcAddr_unmap_mems);
