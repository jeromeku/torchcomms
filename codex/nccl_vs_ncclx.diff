--- thirdparty/nccl/v2_27/src/ras/ras.cc	1970-01-01 00:00:00.000000000 +0000
+++ comms/ncclx/v2_27/src/ras/ras.cc	2025-10-21 14:02:41.628163467 +0000
@@ -0,0 +1,702 @@
+/*************************************************************************
