-  }
-
-  ncclResult_t allocate_elements(unsigned int num_elements, unsigned int *out_start_idx) {
-    if (this->next_unused_idx + num_elements > this->num_elements) {
-      WARN("Not enough space to get elements");
-      return ncclInvalidUsage;
