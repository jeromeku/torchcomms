+  MPI_Allreduce(
+      &commHash, &commHashMax, 1, MPI_UINT64_T, MPI_MIN, MPI_COMM_WORLD);
+  EXPECT_TRUE(commHashMin == commHashMax && commHashMax == commHash);
+}
