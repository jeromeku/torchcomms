-      proxyOps->nextOps = proxyOps->nextOpsEnd = proxyOps->freeOp = -1;
-    }
-  }
-  proxyConn->initialized = true;
-  INFO(NCCL_NET|NCCL_PROXY, "Connected to proxy localRank %d -> connection %p", proxyConn->tpLocalRank, proxyConn->connection);
-  return ncclSuccess;
-}
