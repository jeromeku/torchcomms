-          // Notify SHM
-          resources->shm->recvMem.tail = sub->base + sub->done;
-        }
-        if (sub->done == sub->nsteps) {
-          resources->step = sub->base + sub->nsteps;
-          args->done++;
-        }
-      }
-    }
-    if (args->done == args->nsubs) {
-      args->state = ncclProxyOpNone;
-    }
-  }
-  return ncclSuccess;
