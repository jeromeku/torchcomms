+  EXPECT_EQ(state->nNodes(), comm.nRanks);
+  EXPECT_EQ(state->commHash(), comm.commHash);
+  EXPECT_EQ(state->commDesc(), comm.config.commDesc);
+  for (int i = 0; i < state->nRanks(); ++i) {
