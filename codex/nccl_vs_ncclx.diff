-    }
-  }
-
-  return 0;
-fail:
-  if (addrInfo)
-    freeaddrinfo(addrInfo);
-  if (sock != -1)
-    (void)close(sock);
-  return 1;
-timeout:
-  fprintf(stderr, "Connection timed out; retrying...\n");
