-  unsigned char tmp[2048];
-  const jsonResult_t res = sanitizeJson(tmp, sizeof(tmp), (const unsigned char*)name);
-  if (res != jsonSuccess) {
-    return res;
-  }
-  fprintf(jfo->fp, "\"%s\":", tmp);
-  jsonPushState(jfo, JSON_KEY);
-  return jsonSuccess;
-}
