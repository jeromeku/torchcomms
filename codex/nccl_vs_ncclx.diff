+  auto count = 1 << 20;
+  auto nColl = 10;
+
+  prepareAllreduce(count);
+  for (int i = 0; i < nColl; i++) {
+    NCCLCHECK_TEST(
+        ncclAllReduce(sendBuf, recvBuf, count, ncclInt, ncclSum, comm, stream));
+  }
+  CUDACHECK_TEST(cudaStreamSynchronize(stream));
+
+  EXPECT_EQ(CommsMonitor::getNumOfCommMonitoring(), 1);
+}
