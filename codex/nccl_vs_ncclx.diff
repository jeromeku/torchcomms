-    fprintf(file, " %s=\"%s\"", node->attrs[a].key, node->attrs[a].value);
-  }
-  if (node->nSubs == 0) {
-    fprintf(file, "/>\n");
-  } else {
-    fprintf(file, ">\n");
-    for (int s=0; s<node->nSubs; s++) {
-      NCCLCHECK(ncclTopoDumpXmlRec(indent+2, file, node->subs[s]));
-    }
-    for (int i=0; i<indent; i++) fprintf(file, " ");
