+#define BOOTSTRAP_INIT_TIME_CREATE 0
+#define BOOTSTRAP_INIT_TIME_SEND   1
+#define BOOTSTRAP_INIT_TIME_RECV   2
+#define BOOTSTRAP_INIT_TIME_RING   3
+#define BOOTSTRAP_INIT_TIME_TOTAL  4
