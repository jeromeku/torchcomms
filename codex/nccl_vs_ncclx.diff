-        asm volatile("ld.acquire.cta.b32 %0, [%1];" : : "r"(val), "l"(&dummy));
-    else if (sync_scope == DOCA_GPUNETIO_VERBS_SYNC_SCOPE_GPU)
-        asm volatile("ld.acquire.gpu.b32 %0, [%1];" : : "r"(val), "l"(&dummy));
