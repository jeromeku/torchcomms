+class NcclLoggerTestEnv : public ::testing::Environment {
+ public:
+  void SetUp() override {
+    setenv("NCCL_DEBUG", "INFO", 1);
+    setenv("NCCL_DEBUG_SUBSYS", "INIT,COLL", 1);
