-  NCCLCHECK(ncclCalloc(&rComm->inlineData, MAX_REQUESTS * (SOCKET_CTRL_SIZE + ncclParamSocketInlineSize())));
-  *recvComm = rComm;
-
-  /* reset lComm state */
-  stage->state = ncclNetSocketCommStateStart;
-  stage->iteration = 0;
