+    default:
+      throw std::runtime_error(
+          std::string("ncclToComm: unimplemented nccl RedOp ") +
+          std::to_string(op));
+  }
+}
+
+commCmpOp_t ncclToMetaComm(ncclCmpOp_t op) {
+  switch (op) {
+    case ncclCmpEQ:
+      return commCmpEQ;
