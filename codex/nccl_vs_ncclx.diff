+TEST_P(NcclxBaseTestFixture, NcclCommInitWorldAndAbort) {
+  ncclComm_t rootComm;
+  ncclUniqueId commId;
+  NCCLCHECK_TEST(
+      ncclCommInitRankConfig(&rootComm, numRanks, commId, globalRank, nullptr));
