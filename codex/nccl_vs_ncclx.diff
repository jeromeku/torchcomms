-  // Get CUDA version info once for all output formats.
-  if (cudaRuntimeVersion == -1)
-    cudaRuntimeGetVersion(&cudaRuntimeVersion);
-  if (cudaDriverVersion == -1)
-    cudaDriverGetVersion(&cudaDriverVersion);
