-    for (int i = 0; i < node->nAttrs; i++) {
-      cursor = strlen(line);
-      snprintf(line + cursor, sizeof(line) - cursor, " %s=%s", node->attrs[i].key, node->attrs[i].value);
-    }
-    cursor = strlen(line);
-    snprintf(line + cursor, sizeof(line) - cursor, ">");
