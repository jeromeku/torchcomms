+struct alignas(16) ncclDevWorkCollReg {
+  struct ncclDevWorkColl coll;
+  void* dnInputs[NCCL_MAX_DIRECT_ARITY+1];
+  void* dnOutputs[NCCL_MAX_DIRECT_ARITY+1];
