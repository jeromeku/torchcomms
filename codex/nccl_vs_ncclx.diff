+    1, 1 };
+  ncclResult_t ret;
+  NCCLCHECK(ncclGroupStart());
+  NCCLCHECKGOTO(ncclEnqueueCheck(&info), ret, exit);
+exit:
+  NCCLCHECK(ncclGroupEnd());
+  return ret;
+}
