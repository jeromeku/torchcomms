+  EXPECT_EQ(CommsMonitor::getNumOfCommMonitoring(), 1);
+
+  ncclConfig_t config = NCCL_CONFIG_INITIALIZER;
+  const std::string commDest = "split_comm";
+  config.commDesc = commDest.c_str();
+
+  ncclComm_t splitComm;
+
+  if (globalRank % 2 == 0) {
