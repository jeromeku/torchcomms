-    uint64_t *cpu_db;
-    uint64_t sq_wqe_pi_last;
-    uint64_t *sq_db;
-    __be32 *sq_dbrec;
-    bool cpu_proxy;
-    uint32_t sq_num_shift8_be;
-    /* CPU handler */
