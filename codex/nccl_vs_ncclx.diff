+    EXPECT_EQ(CommsMonitor::getNumOfCommMonitoring(), 2);
+
+    ncclCommDestroy(splitComm);
+  } else {
+    ncclCommSplit(
+        origComm, NCCL_SPLIT_NOCOLOR, globalRank, &splitComm, &config);
+
+    EXPECT_EQ(CommsMonitor::getNumOfCommMonitoring(), 1);
