+TEST(GlobalHintsUT, TestBasicSet) {
+  ncclx::testOnlyResetGlobalHints();
+
+  auto hintMngr = ncclx::GlobalHints::getInstance();
+  hintMngr->regHintEntry(std::string(testGlobalHintKey));
+
+  EXPECT_EQ(
+      ncclx::setGlobalHint(
