-      if (work->sendProtoLL) {
-        runSend<ProtoLL>(subtid, subtn, group, work);
-      } else {
-        runSend<ProtoSimple<1,1>>(subtid, subtn, group, work);
-      }
-    } else {
-      if (work->recvProtoLL) {
-        runRecv<ProtoLL>(subtid, subtn, group, work);
-      } else {
-        runRecv<ProtoSimple<1,1>>(subtid, subtn, group, work);
-      }
-    }
-  }
-};
