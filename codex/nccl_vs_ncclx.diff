-  }
-
-  ncclSpaceConstruct(&ginState->counterSpace);
-  ncclSpaceConstruct(&ginState->signalSpace);
-
-exit:
-  if (ret == ncclSuccess) ginState->connected = true;
-  return ret;
-fail:
-  free(allHandles);
-  free(handles);
-  goto exit;
-}
