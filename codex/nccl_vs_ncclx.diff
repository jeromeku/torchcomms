-
-    #pragma unroll 2
-    for (int partial=0; partial <= 1; partial++) {
-      #pragma unroll 1
-      for (int j = 0;
-           partial ? j < 1 : (dr + UnrollPeers <= nRanks);
-           partial ? j++ : (dr += UnrollPeers)) {
-        if (partial && dr == nRanks) break;
-
-        #pragma unroll
-        for (int u=0; u < UnrollPeers-partial; u++) {
