-	&& node->links[l].remNode != from
-	&& (node->links[l].remNode->type == PCI
-	    || node->links[l].remNode->type == CPU)) {
-      NCCLCHECK(findLocalCpu(node->links[l].remNode, cpu, node));
-    }
-    if (*cpu != NULL) return ncclSuccess;
-  }
-  return ncclSuccess;
