-  const int nqpsPerRank = ncontexts;
-  const int nqpsForComm = nqpsPerRank * nranks;  // Number of QPs for communication
-
-  for (int qpIdx = 0; qpIdx < nqpsForComm; qpIdx++) {
-    struct doca_gpu_verbs_qp *qp = gdakiCtx->gqps[qpIdx]->qp_gverbs;
