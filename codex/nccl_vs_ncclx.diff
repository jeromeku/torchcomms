-              storePack(output, t*EltPerPack, nElts, applyCast<Acc, T>(out));
-            }
-            lla2a.endEpoch(cta);
-
-            input += tn*EltPerPack;
-            output += tn*EltPerPack;
-            nElts -= tn*EltPerPack;
-            nPacks -= tn;
-          }
-        }
-      }
-    );
-}
