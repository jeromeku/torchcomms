-    : m_ibv_ctx(ibv_ctx),
-      m_address(address),
-      m_size(size),
-      m_access_flags(access_flags),
-      m_dmabuf_fd(dmabuf_fd),
-      m_dmabuf_offset(dmabuf_offset) {
-    try {
-        create();
-    } catch (...) {
-        (void)destroy();
-        DOCA_LOG(LOG_ERR, "Failed to create UMEM");
-        throw;
-    }
-}
-
-doca_verbs_umem::~doca_verbs_umem() { static_cast<void>(destroy()); }
