+  ~TCPStore();
+
+  void set(const std::string& key, const std::vector<uint8_t>& value);
+
+  std::vector<uint8_t> get(const std::string& key);
+
+  // Waits for all workers to join.
+  void waitForWorkers();
+
+  static constexpr std::chrono::milliseconds kConnectRetryDelay{1000};
+
+ private:
