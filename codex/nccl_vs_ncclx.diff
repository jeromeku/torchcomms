-      factor = (comm->compCap >= 100 ? 6 : 5) * 8;
-      *recChannels = std::max(comm->config.minCTAs, std::min(comm->config.maxCTAs, DIVUP(factor, comm->nvlsResources->nHeads)));
-    } else if (info->func == ncclFuncAllGather) {
-      factor = 4 * 8;
