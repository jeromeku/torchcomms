-  struct ncclExpectedProxyResponse* prev = NULL;
-  *found = 0;
-  while (elem) {
-    if ((elem->opId == opId) && elem->done) {
-      if (prev == NULL) {
-        state->expectedResponses = elem->next;
-      } else {
-        prev->next = elem->next;
-      }
-      memcpy(respBuff, elem->respBuff, elem->respSize);
-      ncclResult_t res = elem->res;
-      free(elem->respBuff);
-      free(elem);
-      *found = 1;
-      return res;
-    }
-    prev = elem;
-    elem = elem->next;
-  }
-  return ncclSuccess;
-}
