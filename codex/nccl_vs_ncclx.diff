--- thirdparty/nccl/src/graph/trees.cc	2025-10-21 15:28:32.228875649 +0000
+++ comms/ncclx/src/graph/trees.cc	1970-01-01 00:00:00.000000000 +0000
@@ -1,109 +0,0 @@
-/*************************************************************************
