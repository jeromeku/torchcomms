+    cudaStream_t stream) {
+
+  NCCLCHECK(metaCommToNccl(ctranAllToAllvDynamicSupport(comm->ctranComm_.get(), ncclToMetaComm(hints), maxSendcount, maxRecvcount, ncclToMetaComm(datatype))));
+
+  return metaCommToNccl(ctranAllToAllvDynamic(
+      sendbuffs,
