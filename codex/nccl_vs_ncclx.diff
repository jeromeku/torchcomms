+  for (int i = 0; i < 100; i++) {
+    auto comm_ptr = std::make_unique<NcclCommRAII>(
+        this->globalRank, this->numRanks, this->localRank);
+    std::thread t(
+        [](ncclComm_t comm_t_ptr) {
+          for (int j = 0; j < 100; j++) {
+            std::unordered_map<std::string, std::string> dump;
+            ncclCommDump(comm_t_ptr, dump);
