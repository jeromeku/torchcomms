-                                                          uint32_t &mlx5_uar_type) noexcept {
-    switch (uar_type) {
-        case DOCA_VERBS_UAR_ALLOCATION_TYPE_BLUEFLAME:
-            mlx5_uar_type = MLX5DV_UAR_ALLOC_TYPE_BF;
-            break;
