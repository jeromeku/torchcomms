-  while (elem) {
-    if (elem->opId == op->opId) {
-      if (prev == NULL) {
-        peer->asyncOps = elem->next;
-      } else {
-        prev->next = elem->next;
-      }
-
-      if (elem->reqBuff) {
-        free(elem->reqBuff);
