-    }
-    // Read response.
-    bytes = rasRead(sock, msgBuf, sizeof(msgBuf));
-    if (bytes < 0) {
-      if (errno == EAGAIN || errno == EWOULDBLOCK)
-        fprintf(stderr, "Connection timed out\n");
-      else
-        perror("read socket");
-      return 1;
-    }
-    if (bytes == 0) {
-      fprintf(stderr, "NCCL unexpectedly closed the connection\n");
