-            2 * (std::min(1, (nRanks/nNodes-1)) * intraLat + (nRanks/nNodes-1) * 0.4) + interLat;  // Add 0.4 us arity serialization latency
-        } else if (a == NCCL_ALGO_COLLNET_CHAIN) {
