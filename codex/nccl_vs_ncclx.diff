+  int numThreads = 10;
+  std::atomic<bool> run_threads(true);
+  std::vector<std::thread> threads(numThreads);
+
+  std::cout << "Starting concurrent threads to log\n";
+
+  for (int i = 0; i < numThreads; ++i) {
+    threads.emplace_back([&run_threads, i]() {
+      int stageID = 0;
+      while (run_threads) {
