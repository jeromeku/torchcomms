-      NCCLCHECK(ncclSocketSetFd(-1, &sharedProxyState->peerSocks[i]));
-    }
-  }
-
-  proxyConn->tpLocalRank = comm->sharedRes->tpRankToLocalRank[proxyConn->tpRank];
-  sock = sharedProxyState->peerSocks + proxyConn->tpLocalRank;
