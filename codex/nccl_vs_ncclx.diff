+      for (const auto& [key, val] : info.param) {
+        if (key == "NCCL_USE_MEM_CACHE") {
+          name += (val == "1") ? "memOpt" : "Baseline";
+        }
+      }
+      return name;
+    });
+
+int main(int argc, char* argv[]) {
+  ::testing::InitGoogleTest(&argc, argv);
+  ::testing::AddGlobalTestEnvironment(new DistEnvironmentBase);
+  folly::Init init(&argc, &argv);
+  return RUN_ALL_TESTS();
+}
diff -ruN thirdparty/nccl/v2_27/meta/logger/tests/ProcessGlobalErrorsUtilTest.cc comms/ncclx/v2_27/meta/logger/tests/ProcessGlobalErrorsUtilTest.cc
