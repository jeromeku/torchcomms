-    // leaves warps unused.
-    nWarpPerWork = nSendWarpPerWork + nRecvWarpPerWork;
-    // The work index this warp belongs to: workIx = wid/nWarpPerWork
-    int workIx = __popc(__ballot_sync(~0u, (lane+1)*nWarpPerWork <= wid));
