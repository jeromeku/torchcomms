+  auto traceGuard = EnvRAII(NCCL_COLLTRACE, {"trace"});
+
+  NcclCommRAII comm{this->globalRank, this->numRanks, this->localRank};
+  ASSERT_EQ(comm->newCollTrace, nullptr);
