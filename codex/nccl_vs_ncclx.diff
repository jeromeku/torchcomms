-  if (listSize == 0) return true;
-
-  for (int i=0; i<listSize; i++) {
-    if (matchIf(string, ifList[i].prefix, matchExact)
-        && matchPort(port, ifList[i].port)) {
-      return true;
-    }
-  }
-  return false;
-}
