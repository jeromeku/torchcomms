diff -ruN thirdparty/nccl/stable/src/misc/ipcsocket.cc comms/ncclx/stable/src/misc/ipcsocket.cc
--- thirdparty/nccl/stable/src/misc/ipcsocket.cc	1970-01-01 00:00:00.000000000 +0000
+++ comms/ncclx/stable/src/misc/ipcsocket.cc	2025-10-21 14:02:41.584163725 +0000
@@ -0,0 +1,232 @@
+/*
