+  uint64_t commHash = 0;
+  res = ncclCommGetUniqueHash(comm, &commHash);
+  ASSERT_EQ(res, ncclSuccess);
+
+  EXPECT_EQ(commHash, comm->commHash);
+
+  // check all ranks have the same commHash
